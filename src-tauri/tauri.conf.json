{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MirrorLab",
  "version": "2.0.0",
  "identifier": "app.mirrorlab.editor",
  "build": {
    "beforeDevCommand": { "script": "trunk serve --dist dist-dev", "cwd": "../app", "wait": false },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../app" },
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MirrorLab",
        "width": 1360,
        "height": 860,
        "minWidth": 400,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0b0b0c",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost blob: data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Fast, private photo editor",
    "longDescription": "MirrorLab is a fast, private photo editor with RAW development, tone curves, colour grading and looks. Everything runs on your device.",
    "copyright": "© 2025-2026 Pranav Dwivedi. MIT licensed.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "android": { "minSdkVersion": 29 }
  }
}
